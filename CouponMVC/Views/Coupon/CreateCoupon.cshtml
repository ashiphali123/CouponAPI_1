@model CouponDto

@{
    ViewData["Title"] = "Create Coupon";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">Create New Coupon</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateCoupon" method="post">
                        <div class="form-group mb-3">
                            <label asp-for="CouponCode" class="form-label fw-bold"></label>
                            <input asp-for="CouponCode" class="form-control" placeholder="Enter coupon code" />
                            <span asp-validation-for="CouponCode" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="DiscountAmount" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="DiscountAmount" class="form-control" type="number" placeholder="Enter discount amount" />
                            </div>
                            <span asp-validation-for="DiscountAmount" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="MinAmount" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="MinAmount" class="form-control" type="number" placeholder="Enter minimum amount" />
                            </div>
                            <span asp-validation-for="MinAmount" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="CouponIndex" class="btn btn-success px-4">Back to List</a>
                            <button type="submit" class="btn btn-success px-4">Save Coupon</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
